# ----------------------------------------------------------------------
# Hostinger LiteSpeed / Apache Configuration for CPA Aviation
# ----------------------------------------------------------------------

# 1. Prevent Directory Browsing
Options -Indexes

# 2. Set Default Directory Index
DirectoryIndex .output/public/index.html index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 4. Security: Block sensitive files, configs, and source directories
  RewriteRule ^\.(git|github) - [F,L]
  RewriteRule ^(src|backend|frontend|node_modules) - [F,L]
  RewriteRule \.(json|lock|ts|tsx|md|env|config\..*)$ - [F,L]

  # 5. Route requests to .output/public if build output exists
  RewriteCond %{DOCUMENT_ROOT}/.output/public/$1 -f
  RewriteRule ^(.*)$ .output/public/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/.output/public/$1/index.html -f
  RewriteRule ^(.*)$ .output/public/$1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/.output/public/index.html -f
  RewriteRule ^$ .output/public/index.html [L]
</IfModule>

# 6. Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 7. Browser Caching for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# 8. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
