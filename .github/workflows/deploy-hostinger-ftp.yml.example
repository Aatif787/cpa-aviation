# Example GitHub Actions Workflow for automated deployment to Hostinger Shared Hosting via FTP/FTPS
# To enable this workflow:
# 1. Rename this file to deploy-hostinger-ftp.yml
# 2. Add repository secrets in GitHub: Settings > Secrets and variables > Actions:
#    - HOSTINGER_FTP_SERVER: your Hostinger FTP hostname (e.g. ftp.cpaleasing.com or access IP)
#    - HOSTINGER_FTP_USERNAME: your Hostinger FTP username
#    - HOSTINGER_FTP_PASSWORD: your Hostinger FTP password
#
# This workflow builds the project on GitHub Actions runners, crawls all pages into static HTML (.output/public),
# and syncs .output/public/ directly into public_html/ on Hostinger.

name: Deploy to Hostinger FTP

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build-and-deploy:
    name: Build & Deploy to Hostinger
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: "npm"

      - name: Install dependencies
        run: npm ci

      - name: Build and prerender static pages
        run: npm run build

      - name: Sync static files to Hostinger public_html
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.HOSTINGER_FTP_SERVER }}
          username: ${{ secrets.HOSTINGER_FTP_USERNAME }}
          password: ${{ secrets.HOSTINGER_FTP_PASSWORD }}
          local-dir: .output/public/
          server-dir: public_html/
          dangerous-clean-slate: false
